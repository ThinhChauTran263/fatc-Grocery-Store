# ============================================
# RENDER IMPORT TEMPLATE
# ============================================
# HƯỚNG DẪN:
# 1. Điền thông tin Cloudinary vào các dòng có [ĐIỀN VÀO ĐÂY]
# 2. Copy toàn bộ file (trừ phần comment này)
# 3. Vào Render → Environment → "Add from .env"
# 4. Paste và click "Add Variables"
# ============================================

# ===== DATABASE (ĐÃ SẴN SÀNG) =====
# ⚠️ QUAN TRỌNG: Tách username/password ra khỏi URL
SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-d5vlucngi27c73cej9pg-a:5432/java5_asm
SPRING_DATASOURCE_USERNAME=java5_user
SPRING_DATASOURCE_PASSWORD=X04NvMLy7TJE6jT4ckDCW4qIm3KAdO2D
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ===== CLOUDINARY (ĐIỀN THÔNG TIN) =====
# Lấy từ: https://console.cloudinary.com/
USE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=[ĐIỀN CLOUD NAME VÀO ĐÂY]
CLOUDINARY_API_KEY=[ĐIỀN API KEY VÀO ĐÂY]
CLOUDINARY_API_SECRET=[ĐIỀN API SECRET VÀO ĐÂY]

# ===== JWT (ĐÃ SẴN SÀNG) =====
JWT_SECRET=fatc-grocery-store-super-secret-key-2024-minimum-32-chars
JWT_EXPIRATION=86400000

# ===== APPLICATION (ĐÃ SẴN SÀNG) =====
SPRING_PROFILES_ACTIVE=prod
APP_BASE_URL=https://fatc-grocery-store.onrender.com

# ===== GOOGLE OAUTH2 (TÙY CHỌN) =====
# Bỏ comment (xóa dấu #) nếu muốn dùng Google login
# Lấy từ: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=[ĐIỀN CLIENT ID VÀO ĐÂY]
# GOOGLE_CLIENT_SECRET=[ĐIỀN CLIENT SECRET VÀO ĐÂY]

# ===== EMAIL (TÙY CHỌN) =====
# Bỏ comment (xóa dấu #) nếu muốn gửi email
# Tạo App Password: https://myaccount.google.com/apppasswords
# MAIL_USERNAME=[ĐIỀN EMAIL VÀO ĐÂY]
# MAIL_PASSWORD=[ĐIỀN APP PASSWORD VÀO ĐÂY]
# MAIL_FROM=Fat C Grocery Store <noreply@fatcgrocery.com>
