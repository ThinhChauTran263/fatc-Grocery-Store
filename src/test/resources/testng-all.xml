<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Complete Test Suite" verbose="1" parallel="tests" thread-count="2">
    
    <!-- Login Tests -->
    <test name="Login Tests" preserve-order="true">
        <classes>
            <class name="poly.edu.java5_asm.selenium.tests.LoginTestNG"/>
        </classes>
    </test>
    
    <!-- User Service Tests -->
    <test name="User Service Tests">
        <classes>
            <class name="poly.edu.java5_asm.module.user.service.UserServiceTestNGTest"/>
        </classes>
    </test>
    
    <listeners>
        <listener class-name="org.testng.reporters.EmailableReporter"/>
        <listener class-name="org.testng.reporters.JUnitReportReporter"/>
    </listeners>
    
</suite>
